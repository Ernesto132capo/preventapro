# Desarrollo aislado en EC2, accesible únicamente mediante npm run db:tunnel.
# Sustituir los marcadores. En EC2 el servicio usa su propia configuración privada.
DATABASE_URL=postgresql://preventapro_dev:REPLACE_WITH_DEV_PASSWORD@127.0.0.1:55432/preventapro_dev?sslmode=disable

# Conexión SSH del equipo de desarrollo. Nunca publicar la clave privada.
EC2_SSH_HOST=18.227.163.204
EC2_SSH_USER=ubuntu
EC2_SSH_KEY_PATH=/absolute/path/to/private-key.pem
EC2_SSH_KNOWN_HOSTS=/absolute/path/to/verified-known-hosts
EC2_LOCAL_DB_PORT=55432

# Generar un valor propio de al menos 32 caracteres; no reutilizar este marcador.
AUTH_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Puerto HTTP del backend (opcional; por defecto 4000).
PORT=4000

# Intervalo mínimo entre pulls forzados, en milisegundos (opcional; por defecto 45000).
SYNC_FORCE_TTL_MS=45000
