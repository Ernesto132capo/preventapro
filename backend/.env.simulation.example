# Usa una base NUEVA y vacía, diferente de producción y de desarrollo.
# La verificación automática de EC2 está en deploy/ec2/validate-workday.py.
# Copia esta plantilla como .env.simulation (ese archivo está excluido de git).
SIMULATION_DATABASE_URL=postgresql://USER:PASSWORD@TEST_HOST/preventapro_simulation?sslmode=require
SIMULATION_CONFIRM=BASE_DE_PRUEBAS_VACIA

# Opcional: servidor SEPARADO de pruebas conectado a esa misma base VACÍA.
# Si lo dejas comentado, el backend HTTP corre en tu PC.
# SIMULATION_API_URL=https://pruebas.example.com/api
