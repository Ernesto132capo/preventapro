{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBackupPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::preventapro-backups-843780049320-us-east-2",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "postgresql/preventapro/",
            "postgresql/preventapro/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadWriteOwnBackups",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::preventapro-backups-843780049320-us-east-2/postgresql/preventapro/*"
    },
    {
      "Sid": "SendHealthAlerts",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:us-east-2:843780049320:PreventaPro-alerts"
    }
  ]
}
